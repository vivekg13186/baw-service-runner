{
  "name": "baw-service-runner",
  "displayName": "BAW Service Runner",
  "description": "Run IBM Business Automation Workflow services from .baw files.",
  "repository": "https://github.com/vivekg13186/baw-service-runner.git",
  "version": "0.1.0",
  "publisher": "vivekg",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:baw"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "baw.setEnvironment",
        "title": "BAW: Select Environment"
      },
      {
        "command": "baw.setSecret",
        "title": "BAW: Set Secret"
      },
      {
        "command": "baw.deleteSecret",
        "title": "BAW: Delete Secret"
      },
      {
        "command": "baw.clearSharedVariables",
        "title": "BAW: Clear Shared Variables"
      },
      {
        "command": "baw.showResponse",
        "title": "BAW: Show Response"
      },
      {
        "command": "baw.runSequence",
        "title": "BAW: Run Sequence"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
