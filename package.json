{
  "name": "baw-service-runner",
  "displayName": "BAW Service Runner",
  "description": "Run IBM Business Automation Workflow services from .baw files.",
  "version": "0.1.0",
  "publisher": "your-publisher",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:baw"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [{
      "id": "baw",
      "aliases": ["BAW", "baw"],
      "extensions": [".baw"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "baw",
      "scopeName": "source.baw",
      "path": "./syntaxes/baw.tmLanguage.json"
    }],
    "commands": [{
      "command": "baw.runService",
      "title": "BAW: Run Service"
    }]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
