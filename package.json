{
  "name": "baw-service-runner",
  "displayName": "BAW Service Runner",
  "description": "Run IBM Business Automation Workflow services from .baw files.",
  "repository": "https://github.com/vivekg13186/baw-service-runner.git",
  "version": "0.1.0",
  "publisher": "vivekg",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:baw"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "baw",
        "aliases": [
          "BAW",
          "baw"
        ],
        "extensions": [
          ".baw"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "baw",
        "scopeName": "source.baw",
        "path": "./syntaxes/baw.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "baw.setEnvironment",
        "title": "BAW: Select Environment"
      },
      {
        "command": "baw.setSecret",
        "title": "BAW: Set Secret"
      },
      {
        "command": "baw.deleteSecret",
        "title": "BAW: Delete Secret"
      },
      {
        "command": "baw.clearSharedVariables",
        "title": "BAW: Clear Shared Variables"
      },
      {
        "command": "baw.showResponse",
        "title": "BAW: Show Response"
      },
      {
        "command": "baw.runSequence",
        "title": "BAW: Run Sequence"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "baw.setEnvironment",
          "when": "editorLangId == baw",
          "group": "navigation"
        },
        {
          "command": "baw.showResponse",
          "when": "editorLangId == baw",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "baw.runSequence",
          "when": "editorLangId == baw",
          "group": "baw@1"
        },
        {
          "command": "baw.clearSharedVariables",
          "when": "editorLangId == baw",
          "group": "baw@2"
        }
      ]
    },
    "configuration": {
      "title": "BAW Service Runner",
      "properties": {
        "baw.stopSequenceOnError": {
          "type": "boolean",
          "default": true,
          "description": "Stop sequence execution when a service fails."
        },
        "baw.clearVariablesBeforeSequence": {
          "type": "boolean",
          "default": false,
          "description": "Clear shared service variables before running a sequence."
        },
        "baw.requestTimeout": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "HTTP request timeout in milliseconds."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}