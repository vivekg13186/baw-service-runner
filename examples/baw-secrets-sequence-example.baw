# IBM BAW Service Runner - secrets + sequential execution example
#
# Before running, use Command Palette:
#   BAW: Set Secret
# Save these two secrets:
#   BAW_DEV_USERNAME
#   BAW_DEV_PASSWORD
#
# Secrets are stored by VS Code SecretStorage and are not written to this file.
# Run the sequence using the CodeLens above the sequence declaration.

# Environment properties can reference secure secrets.
env dev {
    url: https://baw-dev.example.com
    username: {{secret.BAW_DEV_USERNAME}}
    password: {{secret.BAW_DEV_PASSWORD}}

    environmentName: development
    customerName: John Doe
    customerEmail: john.doe@example.com
    orderType: STANDARD
    currency: EUR
}

env test {
    url: https://baw-test.example.com
    username: {{secret.BAW_TEST_USERNAME}}
    password: {{secret.BAW_TEST_PASSWORD}}

    environmentName: testing
    customerName: Jane Doe
    customerEmail: jane.doe@example.com
    orderType: TEST
    currency: EUR
}

service "Create Customer" {
    id: CustomerApp@CreateCustomer
    {
        "name": "{{customerName}}",
        "email": "{{customerEmail}}",
        "source": "{{environmentName}}"
    }
}

service "Create Order" {
    id: OrderApp@CreateOrder
    {
        "customerId": "{{Create Customer.data.customerId}}",
        "orderType": "{{orderType}}",
        "currency": "{{currency}}",
        "items": [
            { "productCode": "LAPTOP-001", "quantity": 1 },
            { "productCode": "MOUSE-001", "quantity": 2 }
        ]
    }
}

service "Approve Order" {
    id: OrderApp@ApproveOrder
    {
        "orderId": "{{Create Order.data.orderId}}",
        "customerId": "{{Create Customer.data.customerId}}",
        "approvedBy": "{{username}}",
        "approvalSource": "{{environmentName}}"
    }
}

service "Send Order Confirmation" {
    id: OrderApp@SendOrderConfirmation
    {
        "orderId": "{{Create Order.data.orderId}}",
        "customerEmail": "{{customerEmail}}",
        "totalAmount": "{{Create Order.data.order.totalAmount}}",
        "currency": "{{currency}}"
    }
}

sequence "Order Processing" {
    run: "Create Customer"
    run: "Create Order"
    run: "Approve Order"
    run: "Send Order Confirmation"
}
